<%= form_with model: animal, class: "form-stack" do |form| %>
  <% if animal.errors.any? %>
    <div class="form-errors"><%= animal.errors.full_messages.to_sentence %></div>
  <% end %>
  <%= form.label :name, "Common name" %>
  <%= form.text_field :name, required: true %>
  <%= form.label :scientific_name %>
  <%= form.text_field :scientific_name, required: true %>
  <%= form.label :taxonomy, "Taxonomy" %>
  <%= form.text_field :taxonomy, placeholder: "Mammal, Carnivore", required: true %>
  <%= form.label :habitat %>
  <%= form.text_field :habitat, required: true %>
  <%= form.label :image_url, "Image URL" %>
  <%= form.url_field :image_url %>
  <%= form.label :summary %>
  <%= form.text_area :summary, rows: 6, required: true %>
  <%= form.submit submit_label, class: "button button-primary" %>
<% end %>
