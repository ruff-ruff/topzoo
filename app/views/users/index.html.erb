<% content_for :title, "Users | Topzoo" %>
<p class="eyebrow">Admin workspace</p>
<h1>Community members</h1>
<p class="hero-copy">Browse registered users and see the animals they have chosen.</p>
<div class="table-wrap">
  <table class="data-table">
    <thead><tr><th>Username</th><th>Role</th><th>Favorites</th><th></th></tr></thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><strong><%= user.username %></strong></td>
          <td><span class="role-pill"><%= user.role %></span></td>
          <td><%= user.favorites.count %> / 3</td>
          <td><%= link_to "View profile", user_path(user), class: "text-link" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
