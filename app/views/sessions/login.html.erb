<fieldset>
    <legend>Login</legend>
    <%= form_tag '/sessions/create', method: :post do %>
        <div>
            <%= label_tag 'username', "Username" %>
            <%= text_field_tag 'username', '', size:10 %>
        </div>
        <div>
            <%= label_tag 'password', "Password" %>
            <%= password_field_tag 'password', '', size:20 %>
        </div>
        <div>
            <%= submit_tag 'Login' %>
        </div>
    <% end %>
    <%= link_to "Forgotten password", '/users/forgotten' %>
</fieldset>